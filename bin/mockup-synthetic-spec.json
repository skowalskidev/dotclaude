  "variants": {
    "alpha": {
      "label": "Alpha — first idea",
      "why": "Baseline layout.",
      "flashSelector": "#title",
      "captures": {
        "desktop": "<!doctype html><html><head><meta charset=\"utf-8\"><style>\nbody{font-family:sans-serif;margin:0;padding:24px;background:#fff;color:#1A1D26;}\n.card{border:1px solid #E7E6E2;border-radius:8px;padding:16px;max-width:320px;}\n.badge{display:inline-block;background:#2857E5;color:#fff;border-radius:16px;padding:3px 10px;font-size:12px;margin-bottom:8px;}\nh1{font-size:18px;margin:0 0 6px;}\np{font-size:13px;color:#5B5F6B;}\n#state-label{font-weight:600;margin-top:10px;display:block;}\n#alpha-modal{position:fixed;inset:0;background:rgba(20,20,30,.45);display:none;align-items:center;justify-content:center;}#alpha-modal.is-open{display:flex;}#alpha-modal .sheet{background:#fff;border-radius:10px;padding:20px;min-width:240px;box-shadow:0 8px 30px rgba(0,0,0,.25);}\n</style></head><body>\n<div class=\"card\" data-mockup-anchor=\"Alpha-card\">\n<span class=\"badge\">Alpha</span>\n<h1 id=\"title\">Alpha variant</h1>\n<p>Synthetic capture used to prove the generic mockup shell renders, walks states, flashes and accepts pins with no project-specific code.</p>\n<span id=\"state-label\">State: base</span>\n</div>\n<div id=\"alpha-modal\" data-mockup-anchor=\"Alpha-modal\"><div class=\"sheet\"><strong>Alpha modal</strong><p>A modal opened by walking to the modal state.</p></div></div>\n<script>\nwindow.addEventListener('message', function(e){\n  if (!e.data || e.data.type !== 'mockup:goto-state') return;\n  document.getElementById('state-label').textContent = 'State: ' + e.data.stateId;\n  document.getElementById('alpha-modal').classList.toggle('is-open', e.data.stateId === 'modal');\n});\nwindow.addEventListener('message', function(e){\n  if (!e.data || e.data.type !== 'mockup:cleanup') return;\n  document.getElementById('state-label').textContent = 'cleaned up';\n});\n</script>\n</body></html>",
        "mobile": "<!doctype html><html><head><meta charset=\"utf-8\"><style>\nbody{font-family:sans-serif;margin:0;padding:24px;background:#fff;color:#1A1D26;}\n.card{border:1px solid #E7E6E2;border-radius:8px;padding:16px;max-width:320px;}\n.badge{display:inline-block;background:#2857E5;color:#fff;border-radius:16px;padding:3px 10px;font-size:12px;margin-bottom:8px;}\nh1{font-size:18px;margin:0 0 6px;}\np{font-size:13px;color:#5B5F6B;}\n#state-label{font-weight:600;margin-top:10px;display:block;}\n#alpha-modal{position:fixed;inset:0;background:rgba(20,20,30,.45);display:none;align-items:center;justify-content:center;}#alpha-modal.is-open{display:flex;}#alpha-modal .sheet{background:#fff;border-radius:10px;padding:20px;min-width:240px;box-shadow:0 8px 30px rgba(0,0,0,.25);}\n</style></head><body>\n<div class=\"card\" data-mockup-anchor=\"Alpha-card\">\n<span class=\"badge\">Alpha</span>\n<h1 id=\"title\">Alpha variant</h1>\n<p>Synthetic capture used to prove the generic mockup shell renders, walks states, flashes and accepts pins with no project-specific code.</p>\n<span id=\"state-label\">State: base</span>\n</div>\n<div id=\"alpha-modal\" data-mockup-anchor=\"Alpha-modal\"><div class=\"sheet\"><strong>Alpha modal</strong><p>A modal opened by walking to the modal state.</p></div></div>\n<script>\nwindow.addEventListener('message', function(e){\n  if (!e.data || e.data.type !== 'mockup:goto-state') return;\n  document.getElementById('state-label').textContent = 'State: ' + e.data.stateId;\n  document.getElementById('alpha-modal').classList.toggle('is-open', e.data.stateId === 'modal');\n});\nwindow.addEventListener('message', function(e){\n  if (!e.data || e.data.type !== 'mockup:cleanup') return;\n  document.getElementById('state-label').textContent = 'cleaned up';\n});\n</script>\n</body></html>"
      },
