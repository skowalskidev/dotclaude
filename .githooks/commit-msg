#!/usr/bin/env bash
# Reject a commit message that is not a conventional commit.
# Enable on a machine with:  git -C ~/.claude config core.hooksPath .githooks
#
# Why this is a hook and not just a rule: rules/process.md has mandated conventional commits in the
# imperative for a long time and the repo still sat around 38% compliance. An advisory rule that is
# ignored three times in five is not a standard, it is a preference. This makes it bite in the one
# repo a hook can reach; the rule still carries the standard everywhere else.
#
# Scope is deliberately narrow. It checks the SUBJECT line only: type, optional scope, no capital,
# no trailing period, and a length that stays readable in `git log --oneline`. It says nothing about
# the body, because a body is where judgement lives and a regex would only teach people to pad it.

msg_file="$1"
# Strip comments and take the first non-empty line: that is the subject git will actually record.
subject="$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -1)"

# A merge, revert, fixup or squash message is generated by git itself. Not ours to police.
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*) exit 0 ;;
esac

TYPES='feat|fix|docs|chore|refactor|test|perf|build|ci|style|revert'
fail() {
  printf '\n  ✗ %s\n' "$1" >&2
  printf '    subject: %s\n\n' "$subject" >&2
  printf '    Required: <type>(<scope>): <imperative subject>\n' >&2
  printf '    Types:    %s\n' "$(printf '%s' "$TYPES" | tr '|' ' ')" >&2
  printf '    Example:  fix(rules): make ui-conventions actually load\n\n' >&2
  printf '    Fix it with `git commit --amend`. If this rule is genuinely wrong for this commit,\n' >&2
  printf '    `--no-verify` bypasses it — but the secret gate is a separate pre-commit hook and\n' >&2
  printf '    --no-verify skips THAT TOO, so re-run dotfiles/secret-scan.sh by hand if you do.\n\n' >&2
  exit 1
}

[ -z "$subject" ] && fail "Empty commit message."

printf '%s' "$subject" | grep -Eq "^($TYPES)(\([a-z0-9._/-]+\))?!?: .+" \
  || fail "Not a conventional commit subject."

# Everything after the colon is the description git shows in --oneline.
desc="${subject#*: }"
printf '%s' "$desc" | grep -Eq '^[A-Z][a-z]' \
  && fail "Subject starts with a capital. Conventional commits are lower-case: 'add x', not 'Add x'."
case "$desc" in
  *.) fail "Subject ends with a period. It is a title, not a sentence." ;;
esac
[ "${#subject}" -gt 72 ] \
  && fail "Subject is ${#subject} chars. Keep it under 72 so \`git log --oneline\` stays readable."

exit 0
